# Application
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:////tmp/maiia_data/investigations.db

# Vision
VISION_BACKEND=opencv
IMAGE_UPLOAD_DIR=/tmp/maiia_data/uploads
MAX_IMAGE_SIZE_MB=10

# Retrieval
VECTOR_BACKEND=faiss
FAISS_INDEX_PATH=/tmp/maiia_data/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM (optional — system works without it)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent limits
MAX_AGENT_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=15
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MODERATE_THRESHOLD=0.60

# Security
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
